<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="tg2_participant" is_default_profile="true">
    <rtps>
      <!-- UDP only: no shared memory, which avoids the SHM errors in the container -->
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>

      <builtin>
        <initialPeersList>
          <locator><udpv4><address>Host 1</address></udpv4></locator>
          <locator><udpv4><address>Host 2</address></udpv4></locator>
          <locator><udpv4><address>Host 3</address></udpv4></locator>
          <locator><udpv4><address>Local Machine</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>